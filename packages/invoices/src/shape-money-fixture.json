        "subtotal": "11.505",
        "tax": "0.575",
        "total": "12.080"
      }
    },
    {
      "name": "an amount off larger than the line stops at zero",
      "currency": "USD",
      "taxRate": "0",
      "lines": [
        {
          "qty": "1",
          "rate": "50.00",
          "discountKind": "amount",
          "discount": "80",
          "expect": "0.00"
