{
  "adminium": {
    "kind": "invoice-shape-money-fixture",
    "version": 1
  },
  "law": "a line: max(0, qty × rate − amount off) or max(0, qty × rate × (1 − rate off / 100)), or rate × share / 100 for a stage of a quote, rounded once half away from zero to the currency’s decimals; subtotal = the sum of the stored line amounts; tax = subtotal × tax rate / 100 rounded once; total = subtotal + tax",
  "decimals": {
    "JPY": 0,
    "EUR": 2,
    "USD": 2,
    "KWD": 3,
    "BHD": 3,
    "CLP": 0,
    "GBP": 2,
    "ISK": 0,
    "OMR": 3
  },
  "cases": [
    {
      "name": "euros: whole and fractional hours, an amount off, 20 % tax",
      "currency": "EUR",
      "taxRate": "20",
      "lines": [
        {
          "qty": "12",
          "rate": "180.00",
          "expect": "2160.00"
        },
        {
          "qty": "1.5",
          "rate": "145.00",
          "discountKind": "amount",
          "discount": "17.5",
          "expect": "200.00"
        }
      ],
      "expect": {
        "subtotal": "2360.00",
        "tax": "472.00",
        "total": "2832.00"
      }
    },
    {
      "name": "yen: a rate off rounds to whole yen, 8 % tax on 4,049 is 323.92 → 324",
      "currency": "JPY",
      "taxRate": "8",
      "lines": [
        {
          "qty": "3",
          "rate": "1200",
          "discountKind": "percent",
          "discount": "12.5",
          "expect": "3150"
        },
        {
          "qty": "1",
          "rate": "999",
          "discountKind": "amount",
          "discount": "100",
          "expect": "899"
        }
      ],
      "expect": {
        "subtotal": "4049",
        "tax": "324",
        "total": "4373"
      }
    },
    {
      "name": "dinars: three places, 9.0045 rounds half away to 9.005",
