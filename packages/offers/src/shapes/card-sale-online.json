{
  "name": "card-sale-online",
  "version": 1,
  "parts": {
    "order": {
      "columns": [
        {
          "ref": "id",
          "type": "int",
          "role": "pk"
        },
        {
          "ref": "paid_at",
          "type": "timestamptz",
          "nullable": true
        },
        {
          "ref": "cancelled_at",
          "type": "timestamptz",
          "nullable": true
        }
      ]
    },
    "lines": {
      "postings": [
        {
          "id": "card-make",
          "into": {
            "addOn": "offers",
            "ledger": "value",
            "action": "issue"
          },
          "via": "order_id",
          "reserve": {
            "on": {
              "create": true
            }
          },
          "post": {
            "on": {
              "column": "paid_at",
              "set": true
            }
          },
          "reverse": {
            "on": {
              "column": "cancelled_at",
              "set": true
            }
          },
          "map": {
            "amount": "load_amount",
            "to_name": "to_name",
            "to_email": "to_email",
            "message": "message",
            "sender": "sender",
            "language": "language",
            "send_on": "send_on"
          }
        },
        {
          "id": "card-recall",
          "into": {
            "addOn": "offers",
            "ledger": "value",
            "action": "recall"
          },
          "via": "order_id",
          "post": {
            "on": {
              "column": "cancelled_at",
              "set": true
            }
          },
          "map": {
            "sale": {
              "row": true
            }
          }
        }
      ],
      "columns": [
        {
          "ref": "id",
          "type": "int",
          "role": "pk"
        },
        {
          "ref": "order_id",
          "type": "fk",
          "references": "order"
        },
        {
          "ref": "load_amount",
          "type": "money",
          "scale": "currency"
        },
        {
          "ref": "to_name",
          "type": "text",
          "maxLength": 80,
          "nullable": true,
          "rules": {
            "plainText": true
          }
        },
        {
          "ref": "to_email",
          "type": "text",
          "maxLength": 254,
          "rules": {
            "validation": {
              "format": "email"
            }
          }
        },
        {
          "ref": "message",
          "type": "text",
          "maxLength": 200,
          "nullable": true,
          "rules": {
            "plainText": {
              "digits": 20,
              "max": 200
            }
          }
        },
        {
          "ref": "sender",
          "type": "text",
          "maxLength": 80,
          "nullable": true,
          "rules": {
            "plainText": true
          }
        },
        {
          "ref": "language",
          "type": "text",
          "maxLength": 12,
          "nullable": true
        },
        {
          "ref": "send_on",
          "type": "date",
          "nullable": true
        }
      ]
    }
  }
}
