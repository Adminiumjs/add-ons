{
  "name": "voucher-sale-online",
  "version": 1,
  "parts": {
    "order": {
      "columns": [
        {
          "ref": "id",
          "type": "int",
          "role": "pk"
        },
        {
          "ref": "paid_at",
          "type": "timestamptz",
          "nullable": true
        },
        {
          "ref": "cancelled_at",
          "type": "timestamptz",
          "nullable": true
        },
        {
          "ref": "customer_proved",
          "type": "bool",
          "default": false
        }
      ]
    },
    "lines": {
      "postings": [
        {
          "id": "pack-make",
          "into": {
            "addOn": "offers",
            "ledger": "value",
            "action": "sell-pack"
          },
          "via": "order_id",
          "reserve": {
            "on": {
              "create": true
            }
          },
          "post": {
            "on": {
              "column": "paid_at",
              "set": true
            }
          },
          "reverse": {
            "on": {
              "column": "cancelled_at",
              "set": true
            }
          },
          "map": {
            "amount": "sale_amount",
            "name": "pack_name",
            "uses": "pack_uses",
            "what": "pack_what",
            "target": "target_id",
            "holder_email": "holder_email",
            "holder_name": "holder_name",
            "language": "language",
            "proved": {
              "parent": "customer_proved"
            },
            "tax_later": "tax_later"
          }
        },
        {
          "id": "pack-recall",
          "into": {
            "addOn": "offers",
            "ledger": "value",
            "action": "recall-pack"
          },
          "via": "order_id",
          "post": {
            "on": {
              "column": "cancelled_at",
              "set": true
            }
          },
          "reverse": {
            "on": {
              "column": "paid_at",
              "set": true
            }
          },
          "map": {
            "sale": {
              "row": true
            }
          }
        }
      ],
      "columns": [
        {
          "ref": "id",
          "type": "int",
          "role": "pk"
        },
        {
          "ref": "order_id",
          "type": "fk",
          "references": "order"
        },
        {
          "ref": "sale_amount",
          "type": "money",
          "scale": "currency"
        },
        {
          "ref": "pack_name",
          "type": "text",
          "maxLength": 120
        },
        {
          "ref": "pack_uses",
          "type": "int",
          "rules": {
            "validation": {
              "min": 1,
              "max": 50
            }
          }
        },
        {
          "ref": "pack_what",
          "type": "enum",
          "enum": [
            "item",
            "category",
            "type",
            "tag"
          ]
        },
        {
          "ref": "holder_email",
          "type": "text",
          "maxLength": 254,
          "rules": {
            "validation": {
              "format": "email"
            }
          }
        },
        {
          "ref": "holder_name",
          "type": "text",
          "maxLength": 80,
          "nullable": true,
          "rules": {
            "plainText": true
          }
        },
        {
          "ref": "language",
          "type": "text",
          "maxLength": 12,
          "nullable": true
        },
        {
          "ref": "tax_later",
          "type": "bool",
          "default": false,
          "nullable": true
        }
      ]
    }
  }
}
