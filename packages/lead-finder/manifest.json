              "en-US": "Telling them",
              "de-DE": "Benachrichtigung",
              "fr-FR": "Information",
              "da-DK": "Underretning",
              "cs-CZ": "Informování",
              "ar-EG": "الإبلاغ",
              "zh-CN": "告知状态",
              "zh-TW": "告知狀態"
