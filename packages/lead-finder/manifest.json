                      "de-DE": "2 Jahre",
                      "fr-FR": "2 ans",
                      "da-DK": "2 år",
                      "cs-CZ": "2 roky",
                      "ar-EG": "سنتان",
                      "zh-CN": "2 年",
                      "zh-TW": "2 年"
