            "maxLength": 64,
            "rules": {
              "tableRef": true
            },
            "label": {
              "en-US": "Kept in",
              "de-DE": "Gespeichert in",
              "fr-FR": "Conservé dans",
              "da-DK": "Gemt i",
              "cs-CZ": "Uloženo v",
              "ar-EG": "محفوظ في",
              "zh-CN": "保存在",
              "zh-TW": "保存在"
            }
          },
          {
            "ref": "person_key",
            "type": "text",
            "maxLength": 200,
            "label": {
              "en-US": "Person",
              "de-DE": "Person",
              "fr-FR": "Personne",
              "da-DK": "Person",
              "cs-CZ": "Osoba",
              "ar-EG": "الشخص",
              "zh-CN": "人员",
              "zh-TW": "人員"
            }
          },
