                    "zh-CN": "等待告知",
                    "zh-TW": "等待告知"
                  },
                  "told": {
                    "en-US": "Told",
                    "de-DE": "Informiert",
                    "fr-FR": "Informé",
                    "da-DK": "Underrettet",
                    "cs-CZ": "Informováno",
                    "ar-EG": "تم الإبلاغ",
                    "zh-CN": "已告知",
                    "zh-TW": "已告知"
